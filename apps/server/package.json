{
  "name": "@absah/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n http,worker -c blue,magenta \"tsx watch src/entrypoints/http.ts\" \"tsx watch src/entrypoints/worker.ts\"",
    "dev:http": "tsx watch src/entrypoints/http.ts",
    "dev:worker": "tsx watch src/entrypoints/worker.ts",
    "build": "tsup",
    "start:http": "node dist/http.js",
    "start:worker": "node dist/worker.js",
    "school:create": "tsx src/entrypoints/create-school.ts",
    "attendance:generate": "tsx src/entrypoints/generate-sessions.ts",
    "billing:exempt": "tsx src/entrypoints/billing-exempt.ts",
    "gate:load-fixture": "tsx src/entrypoints/gate-load-fixture.ts",
    "notify:last-link": "tsx src/entrypoints/notify-last-link.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@absah/capabilities": "workspace:*",
    "@absah/contracts": "workspace:*",
    "@absah/db": "workspace:*",
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "better-auth": "^1.7.25",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pdfkit": "0.20.2",
    "pg-boss": "^12.38.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@absah/config": "workspace:*",
    "@better-auth/utils": "0.5.1",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5",
    "@types/pdfkit": "0.17.7",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.3.2",
    "tsup": "^8.5.0"
  }
}
