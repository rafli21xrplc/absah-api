{
  "name": "absah-api",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "db:migrate": "pnpm --filter @absah/db db:migrate",
    "db:check-rls": "pnpm --filter @absah/db db:check-rls"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.20.5",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.15.0",
    "globals": "^16.0.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.11",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
