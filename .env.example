# Copy to .env.local (gitignored) and fill in. See docs/environments.md.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
APP_VERSION=0.0.0
# Pooled URL (Neon "-pooler" host, transaction mode): API and worker
DATABASE_URL=
# Direct URL (no "-pooler"): migrations, db:check-rls, seed
DATABASE_URL_DIRECT=
# Role without BYPASSRLS that withTenant switches to
DB_APP_ROLE=absah_app
# Local/CI Postgres 16 for integration tests. Never a shared or production database.
TEST_DATABASE_URL=postgresql://localhost:5432/absah_test
