# Copy to .env.local (gitignored) and fill in. See docs/environments.md.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
APP_VERSION=0.0.0
# Pooled URL (Neon "-pooler" host, transaction mode): API and worker
DATABASE_URL=
# Direct URL (no "-pooler"): migrations, db:check-rls, seed
DATABASE_URL_DIRECT=
# Role without BYPASSRLS that withTenant switches to
DB_APP_ROLE=absah_app
# Local/CI Postgres 16 for integration tests. Never a shared or production database.
TEST_DATABASE_URL=postgresql://localhost:5432/absah_test
# Better Auth. Secret: 32+ random chars, different per environment (openssl rand -base64 36).
BETTER_AUTH_SECRET=
# Public origin the browser uses (absah-app web; it proxies /api/* here)
BETTER_AUTH_URL=http://localhost:3000
# Kiosk app origins (static export calling /api/v1/kiosk/* directly), comma separated
KIOSK_ORIGINS=http://localhost:3001
# Extra origins allowed to call /api/auth/* (comma-separated)
TRUSTED_ORIGINS=http://localhost:3000
AUTH_RATE_LIMIT=true
# Client IP header for auth rate limiting. Behind Cloudflare keep cf-connecting-ip only.
AUTH_IP_HEADERS=cf-connecting-ip
# Column encryption (AES-256-GCM). "<keyId>:<base64 32 bytes>" comma-separated; generate a key with
# `openssl rand -base64 32`. Keep retired keys listed until rotation has re-encrypted their rows.
ENCRYPTION_KEYS=
ENCRYPTION_ACTIVE_KEY_ID=
# HMAC key for IP hashes and tracking codes (32+ chars, openssl rand -base64 36). Changing it breaks
# matching of existing hashes.
HASH_KEY=

# File storage. fs = local disk (dev/test) behind a signed upload route; r2 = Cloudflare R2
# (required in production; bucket CORS must allow PUT with Content-Type from the web origin).
STORAGE_DRIVER=fs
STORAGE_FS_DIR=.data/storage
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
