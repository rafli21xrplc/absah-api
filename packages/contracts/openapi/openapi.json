{
  "openapi": "3.1.0",
  "info": {
    "title": "Absah API",
    "version": "0.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token",
        "description": "Session cookie from /api/auth/* (Better Auth)."
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "service": {
            "type": "string",
            "enum": [
              "absah-api"
            ]
          },
          "version": {
            "type": "string"
          },
          "time": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "time"
        ]
      },
      "ErrorBody": {
        "type": "object",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string"
          },
          "details": {},
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ]
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "VALIDATION_FAILED",
          "UNAUTHENTICATED",
          "TWO_FACTOR_REQUIRED",
          "FORBIDDEN",
          "NOT_FOUND",
          "CONFLICT",
          "CAPABILITY_DISABLED",
          "IDEMPOTENCY_KEY_REUSED",
          "IDEMPOTENCY_IN_PROGRESS",
          "RATE_LIMITED",
          "INTERNAL"
        ]
      },
      "MeContextResponse": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "phoneNumber": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "twoFactorEnabled": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "name",
              "email",
              "phoneNumber",
              "twoFactorEnabled"
            ]
          },
          "schools": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MeSchool"
            }
          },
          "active": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "schoolId": {
                "type": "string",
                "format": "uuid"
              },
              "roles": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Role"
                }
              },
              "capabilities": {
                "$ref": "#/components/schemas/CapabilityMap"
              }
            },
            "required": [
              "schoolId",
              "roles",
              "capabilities"
            ]
          }
        },
        "required": [
          "user",
          "schools",
          "active"
        ]
      },
      "MeSchool": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "level": {
            "$ref": "#/components/schemas/SchoolLevel"
          },
          "isMadrasah": {
            "type": "boolean"
          },
          "timezone": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Role"
            }
          }
        },
        "required": [
          "id",
          "name",
          "level",
          "isMadrasah",
          "timezone",
          "roles"
        ]
      },
      "SchoolLevel": {
        "type": "string",
        "enum": [
          "sd",
          "smp",
          "sma",
          "smk"
        ]
      },
      "Role": {
        "type": "string",
        "enum": [
          "admin",
          "operator",
          "kepsek",
          "wakasek",
          "wali_kelas",
          "guru",
          "piket",
          "petugas_uks",
          "tppk",
          "pembina",
          "humas_pkl",
          "pembimbing_pkl",
          "pembimbing_industri",
          "orang_tua",
          "siswa"
        ]
      },
      "CapabilityMap": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/components/schemas/CapabilityValue"
        }
      },
      "CapabilityValue": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "string"
          }
        ]
      },
      "SchoolMembersResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SchoolMember"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "SchoolMember": {
        "type": "object",
        "properties": {
          "membershipId": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "status": {
            "$ref": "#/components/schemas/MembershipStatus"
          },
          "academicYearId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        },
        "required": [
          "membershipId",
          "userId",
          "name",
          "email",
          "role",
          "status",
          "academicYearId"
        ]
      },
      "MembershipStatus": {
        "type": "string",
        "enum": [
          "active",
          "invited",
          "suspended"
        ]
      },
      "UpdateMembershipStatusRequest": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "active",
              "suspended"
            ]
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "SchoolProfileResponse": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "npsn": {
            "type": [
              "string",
              "null"
            ]
          },
          "nsm": {
            "type": [
              "string",
              "null"
            ]
          },
          "timezone": {
            "type": "string"
          },
          "level": {
            "$ref": "#/components/schemas/SchoolLevel"
          },
          "isMadrasah": {
            "type": "boolean"
          },
          "capabilities": {
            "$ref": "#/components/schemas/CapabilityMap"
          }
        },
        "required": [
          "name",
          "npsn",
          "nsm",
          "timezone",
          "level",
          "isMadrasah",
          "capabilities"
        ]
      },
      "UpdateSchoolProfileRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          },
          "npsn": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{8}$"
          },
          "nsm": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{12}$"
          },
          "timezone": {
            "$ref": "#/components/schemas/SchoolTimezone"
          },
          "level": {
            "$ref": "#/components/schemas/SchoolLevel"
          },
          "isMadrasah": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "SchoolTimezone": {
        "type": "string",
        "enum": [
          "Asia/Jakarta",
          "Asia/Makassar",
          "Asia/Jayapura"
        ]
      },
      "SchoolCapabilitiesResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CapabilitySetting"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "CapabilitySetting": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "bool",
              "enum"
            ]
          },
          "options": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "preset": {
            "$ref": "#/components/schemas/CapabilityValue"
          },
          "override": {
            "$ref": "#/components/schemas/CapabilityValue"
          },
          "pending": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "value": {
                "$ref": "#/components/schemas/CapabilityValue"
              },
              "effectiveFrom": {
                "type": "string",
                "format": "date"
              }
            },
            "required": [
              "value",
              "effectiveFrom"
            ]
          },
          "killSwitch": {
            "$ref": "#/components/schemas/CapabilityValue"
          },
          "deferred": {
            "type": "boolean"
          },
          "effective": {
            "$ref": "#/components/schemas/CapabilityValue"
          }
        },
        "required": [
          "key",
          "kind",
          "options",
          "preset",
          "override",
          "pending",
          "killSwitch",
          "deferred",
          "effective"
        ]
      },
      "UpdateSchoolCapabilitiesRequest": {
        "type": "object",
        "properties": {
          "values": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/CapabilityValue"
            }
          }
        },
        "required": [
          "values"
        ],
        "additionalProperties": false
      },
      "SchoolSetupResponse": {
        "type": "object",
        "properties": {
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "#/components/schemas/SetupStep"
                },
                "status": {
                  "$ref": "#/components/schemas/SetupStepStatus"
                }
              },
              "required": [
                "id",
                "status"
              ]
            }
          },
          "completedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "profile": {
            "$ref": "#/components/schemas/SchoolProfile"
          }
        },
        "required": [
          "steps",
          "completedAt",
          "profile"
        ]
      },
      "SetupStep": {
        "type": "string",
        "enum": [
          "profile",
          "level",
          "mbg",
          "import",
          "gate",
          "invite"
        ]
      },
      "SetupStepStatus": {
        "type": "string",
        "enum": [
          "todo",
          "done",
          "skipped"
        ]
      },
      "SchoolProfile": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "npsn": {
            "type": [
              "string",
              "null"
            ]
          },
          "nsm": {
            "type": [
              "string",
              "null"
            ]
          },
          "timezone": {
            "type": "string"
          },
          "level": {
            "$ref": "#/components/schemas/SchoolLevel"
          },
          "isMadrasah": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "npsn",
          "nsm",
          "timezone",
          "level",
          "isMadrasah"
        ]
      },
      "UpdateSetupStepRequest": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "done",
              "skipped"
            ]
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "InvitationResponse": {
        "type": "object",
        "properties": {
          "membershipId": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "inviteUrl": {
            "type": "string",
            "format": "uri"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "membershipId",
          "role",
          "inviteUrl",
          "expiresAt"
        ]
      },
      "CreateInvitationRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phoneNumber": {
            "type": "string",
            "pattern": "^\\+628\\d{7,12}$"
          },
          "role": {
            "$ref": "#/components/schemas/StaffRole"
          }
        },
        "required": [
          "name",
          "role"
        ],
        "additionalProperties": false
      },
      "StaffRole": {
        "type": "string",
        "enum": [
          "admin",
          "operator",
          "kepsek",
          "wakasek",
          "wali_kelas",
          "guru",
          "piket",
          "petugas_uks",
          "tppk",
          "pembina",
          "humas_pkl",
          "pembimbing_pkl",
          "pembimbing_industri"
        ]
      },
      "InvitationPreviewResponse": {
        "type": "object",
        "properties": {
          "schoolName": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "name": {
            "type": "string"
          },
          "loginMethod": {
            "type": "string",
            "enum": [
              "password",
              "otp"
            ]
          },
          "needsPassword": {
            "type": "boolean"
          }
        },
        "required": [
          "schoolName",
          "role",
          "name",
          "loginMethod",
          "needsPassword"
        ]
      },
      "InvitationTokenRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 40,
            "maxLength": 200
          }
        },
        "required": [
          "token"
        ],
        "additionalProperties": false
      },
      "AcceptInvitationResponse": {
        "type": "object",
        "properties": {
          "schoolId": {
            "type": "string",
            "format": "uuid"
          },
          "schoolName": {
            "type": "string"
          },
          "loginMethod": {
            "type": "string",
            "enum": [
              "password",
              "otp"
            ]
          }
        },
        "required": [
          "schoolId",
          "schoolName",
          "loginMethod"
        ]
      },
      "AcceptInvitationRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 40,
            "maxLength": 200
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128
          }
        },
        "required": [
          "token"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "platform"
        ],
        "summary": "Liveness check",
        "responses": {
          "200": {
            "description": "API is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me/context": {
      "get": {
        "tags": [
          "platform"
        ],
        "summary": "Current user, their schools, and roles in the active school",
        "description": "X-School-Id is optional here. Admin/operator without TOTP get 403 TWO_FACTOR_REQUIRED when a school is selected.",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "X-School-Id",
            "in": "header",
            "description": "Active school (workspace). Must be a school where the user has an active membership.",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Context",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeContextResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed (VALIDATION_FAILED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "No session (UNAUTHENTICATED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Not a member, wrong role (FORBIDDEN) or 2FA missing (TWO_FACTOR_REQUIRED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/school/members": {
      "get": {
        "tags": [
          "platform"
        ],
        "summary": "Members of the active school (admin, operator, kepsek, wakasek)",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "X-School-Id",
            "in": "header",
            "description": "Active school (workspace). Must be a school where the user has an active membership.",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Members",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchoolMembersResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed (VALIDATION_FAILED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "No session (UNAUTHENTICATED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Not a member, wrong role (FORBIDDEN) or 2FA missing (TWO_FACTOR_REQUIRED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/school/members/{membershipId}": {
      "patch": {
        "tags": [
          "platform"
        ],
        "summary": "Activate or suspend a membership (admin)",
        "description": "Idempotent: send Idempotency-Key. Admins cannot change their own membership.",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "X-School-Id",
            "in": "header",
            "description": "Active school (workspace). Must be a school where the user has an active membership.",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "One key per user action, reused on retry. Same key with a different body gives 422.",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_\\-:.]{8,128}$"
            }
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "membershipId",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMembershipStatusRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated membership. Replays carry Idempotent-Replayed: true.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchoolMember"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed (VALIDATION_FAILED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "No session (UNAUTHENTICATED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Not a member, wrong role (FORBIDDEN) or 2FA missing (TWO_FACTOR_REQUIRED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Not found (NOT_FOUND); unknown, used or expired invitation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Same Idempotency-Key still running (IDEMPOTENCY_IN_PROGRESS) or state conflict (CONFLICT)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Idempotency-Key reused with a different request (IDEMPOTENCY_KEY_REUSED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/school/profile": {
      "patch": {
        "tags": [
          "academic"
        ],
        "summary": "Change the school level / madrasah profile",
        "description": "Admin only. Idempotent: send Idempotency-Key. attendance.mode changes apply from tomorrow (school timezone).",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "X-School-Id",
            "in": "header",
            "description": "Active school (workspace). Must be a school where the user has an active membership.",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "One key per user action, reused on retry. Same key with a different body gives 422.",
